# =============================================================================
# GhostStudio AI — Environment Variables Template
# =============================================================================
# Copy this file to .env and fill in the values.
# NEVER commit your .env file to version control.
# =============================================================================

# ─── Core ──────────────────────────────────────────────────────────────────────
NODE_ENV=development
DATABASE_URL="file:./dev.db"
NEXTAUTH_URL=http://localhost:3000
NEXTAUTH_SECRET=  # Generate with: openssl rand -base64 32

# ─── Encryption ────────────────────────────────────────────────────────────────
ENCRYPTION_KEY=  # Generate with: openssl rand -hex 32
ENCRYPTION_SALT=  # Generate with: openssl rand -hex 16

# ─── OAuth Providers (optional) ────────────────────────────────────────────────
GITHUB_ID=
GITHUB_SECRET=
GOOGLE_ID=
GOOGLE_SECRET=

# ─── Stripe ────────────────────────────────────────────────────────────────────
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_CREATOR_PRICE_ID=
STRIPE_PRO_PRICE_ID=
STRIPE_AGENCY_PRICE_ID=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=

# ─── App URL ───────────────────────────────────────────────────────────────────
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ─── Docker (PostgreSQL for production) ────────────────────────────────────────
POSTGRES_PASSWORD=  # REQUIRED: Set a strong password before deploying

# ─── Python Engines ───────────────────────────────────────────────────────────
HEATMAP_CLIPPER_URL=http://localhost:5001
PIXELLE_VIDEO_URL=http://localhost:8000

# ─── Browser Automation ───────────────────────────────────────────────────────
PUPPETEER_MAX_INSTANCES=5
PUPPETEER_IDLE_TIMEOUT=300000
PUPPETEER_HEADLESS=true
