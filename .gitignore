# Dependencies
node_modules/

# Next.js build output
.next/
out/
dist/

# Environment files
.env
.env.local
.env.development
.env.development.local
.env.test.local
.env.production
.env.production.local
.env*.local
.env.example

# Database (SQLite dev)
dev.db
*.db
*.db-journal
*.db-wal
*.db-shm

# Logs
dev.log
server.log
npm-debug.log*

# Prisma migrations (generated locally)
prisma/migrations/

# TypeScript build info
tsconfig.tsbuildinfo

# IDE
.vscode/
.idea/

# OS
.DS_Store
Thumbs.db

# Coverage
coverage/
.nyc_output/

# Vercel
.vercel/

# Turbo
.turbo/

# Python engines
engine/data/
__pycache__/
*.pyc
*.pyo
venv_tmp/
venv/
*.egg-info/

# Replit
.replit

# Security - never commit these
*.pem
*.crt
*.key
*.p12
*.jks

# Upload directory (large binary files - use object storage)
upload/*.docx
upload/*.xlsx
upload/*.pdf
upload/*.jpg
upload/*.zip

# Temp files
temp/
